SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True
PORT=5000
ROOM_EXPIRY_HOURS=24

# In-room chat (session-scoped, in-memory)
CHAT_MAX_LEN=500
CHAT_HISTORY=200
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW=5

# WebRTC ICE configuration (video + screen mirroring)
STUN_URL=stun:stun.l.google.com:19302
# TURN is required for viewers behind strict NATs / symmetric firewalls
TURN_URL=turn:your-turn-host:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-credential

# Socket.IO async mode: eventlet (default), gevent, or threading
SOCKETIO_ASYNC_MODE=eventlet

# Production: run one gevent worker so the in-process room store stays consistent:
#   gunicorn --worker-class geventwebsocket.gunicorn.workers.GeventWebSocketWorker -w 1 -b 0.0.0.0:5000 wsgi:app
